{
  "name": "blazon-v2",
  "productName": "Blazon V2",
  "version": "0.2.0",
  "description": "Blazon V2, branché sur Steam",
  "author": "Breezydev",
  "main": "main.js",
  "build": {
    "appId": "com.blazon.v2",
    "productName": "Blazon V2",
    "files": [
      "main.js",
      "coeur/**/*",
      "app/**/*"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icone.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Blazon-V2.exe"
    },
    "directories": {
      "output": "sortie"
    }
  }
}
