{
  "name": "blazon-carmin",
  "productName": "Blazon",
  "version": "0.3.0",
  "description": "Blazon, tous tes jeux dans un seul lanceur",
  "author": "Breezydev",
  "main": "main.js",
  "build": {
    "appId": "com.blazon.carmin",
    "productName": "Blazon",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "files": [
      "main.js",
      "icone.png",
      "coeur/**/*",
      "app/**/*"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icone.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Blazon.exe"
    },
    "directories": {
      "output": "sortie"
    }
  }
}
